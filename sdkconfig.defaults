# --- 目标芯片 ---
# 支持 ESP32-C3 (AI PASSPORT 原版, 8MB flash, 无 PSRAM) 和
# ESP32-S3 (M5Stack StopWatch, 16MB flash, 8MB octal PSRAM)
# 构建时通过 idf.py set-target 选择芯片型号
CONFIG_IDF_TARGET="esp32s3"

# ESP32-S3 PSRAM 配置 (StopWatch 使用 8MB octal PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# --- Flash / 分区 ---
# ESP32-C3 (AI PASSPORT): 8MB flash, 分区结束于 0x800000 (8MB)
# ESP32-S3 (StopWatch): 16MB flash, 分区可扩展至 0x1000000 (16MB)
# HEADER_FLASHSIZE_UPDATE 让 idf.py/esptool 在烧录时把实际探测容量写进镜像头,
# 可避免镜像头容量与芯片不符;它不会扩大片上 flash,也不会使小容量芯片容纳大分区表。
# (该选项与 Secure Boot 不兼容;将来若启用安全启动需改为分构建配置。)
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-stopwatch.csv"

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 注:LVGL 9 已无 CONFIG_LV_COLOR_16_SWAP;字节交换改由
# esp_lvgl_port 的 lvgl_port_display_cfg_t.flags.swap_bytes 控制(见 lvgl_port_setup.c)。
# 档案卡界面用到的字号
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_34=y

# --- 控制台:USB-Serial-JTAG ---
# ESP32-C3 (AI PASSPORT): GPIO18/19 原生 USB-Serial-JTAG
# ESP32-S3 (StopWatch): GPIO19/20 USB-Serial-JTAG
# 单根 USB-C 同时用于烧录、日志 (printf/ESP_LOG)
# StopWatch 引脚配置详见 board_config.h 多板选择逻辑
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=y

# --- 系统 ---
# 为固定 3MiB 应用分区保留升级余量；保留断言和日志，不裁剪字库/功能。
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# ble_config.c 同时作为 GATT peripheral/broadcaster 提供配置服务,并作为 GATT client
# 主动发起 MTU exchange;ble_scan.c 使用 observer 扫描 token/profile 广播。
# 显式锁定源码需要的角色,避免 IDF/组件默认值变化后静默裁掉功能。
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_GATT_SERVER=y

# ble_config.c 每条连接请求一次 MTU 256；实际取双方支持值的最小值。
# 截图通知按协商后的 ATT payload(MTU-3)分包，兼容 185/23，无需降档重发。
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256

# 低功耗:空闲超时后进入 deep sleep，由 GPIO0 ADC 功能键节点低电平唤醒。
# 运行期间保留 BLE modem sleep，并启用 DFS：有任务时最高 160MHz，
# 空闲时自动降到 XTAL 40MHz。暂不启用 Auto Light-sleep，避免影响 BLE/LVGL 时序。
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# --- 内存优化(C3 无 PSRAM,总堆仅 ~176KB,每一 KB 都要争)---
# LVGL 内置 malloc 会在 .bss 里开一块**独立静态池**,它不与系统堆共享 ——
# 用不完的部分等于被"搁浅",BLE/音频一个字节都拿不到(历史上 BLE 初始化被挤崩就与此有关)。
# 保留40KiB。36KiB虽通过原生UI测试,真机从保留首页进入玩法时仍触发
# taskLVGL watchdog；不能用独立页面峰值推断完整导航期间的临时分配需求。
#
# ⚠ 判断依据只能用日志里的 lv_peak(= lv_mem_monitor 的 max_used,**历史峰值**),
#   绝不能用瞬时占用:LVGL 绘制时临时分配的 layer/draw 缓冲(整屏圆角 clip_corner 尤其吃)
#   在两次采样之间就已释放,瞬时值会严重低估真实需求。
#   实测教训:按瞬时值(~12KB)把池砍到 28KB → LVGL 在 TLSF 里反复找不到块、绘制卡死,
#   IDLE 喂不到狗触发 task_wdt,开机直接卡在建界面阶段。
#   池不足的表现是"卡死/看门狗",**不是** assert —— 不要指望它会干脆地报错。
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_USE_QRCODE=y

# NimBLE 按"实际只用 1 条连接"收敛(ble_config.c 的 s_conn 是单句柄)。
# 这几项的缓冲是运行时从堆分配的(MEM_ALLOC_MODE_INTERNAL),故省在运行期堆、不体现在 .bss。
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
# Clicker 的键盘绑定需要跨重启持久化。容量仍限定为一台演示电脑。
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# GATT Service Changed、配置状态、截图、HID 键盘和鼠标各需要一个 CCCD。
CONFIG_BT_NIMBLE_MAX_CCCDS=5
# 控制器并发活动数:1 连接 + 广播 + 扫描 = 3,留 1 余量。再低可能导致广播/扫描起不来。
CONFIG_BT_CTRL_BLE_MAX_ACT=4
CONFIG_LV_USE_FONT_COMPRESSED=y

# XiaoZhi voice is half duplex and needs bounded network memory on a no-PSRAM C3.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# Keep the full server-record receive limit. ESP-TLS fragments writes to the
# outgoing limit; 1KiB avoids a 4KiB transient send allocation during recording.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=1024


CONFIG_LV_MEM_SIZE_KILOBYTES=40

CONFIG_LWIP_UDP_RECVMBOX_SIZE=24
# Queue compact L3 packets rather than retaining1700B Wi-Fi driver buffers for
# each small Opus packet. XiaoZhi also sets a bounded per-socket byte budget.
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_LWIP_SO_RCVBUF=y

# Verify certificates in-place; retain verification, not a copied peer chain.
# The server DER chain stays in the TLS input buffer during verification.
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n

